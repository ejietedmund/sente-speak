# Copy this file to backend/.env and edit as needed.
# All variables are read by the backend with the SENTE_ prefix.

# Absolute path to the folder containing the .tflite model and labels.txt.
# Leave empty to auto-detect backend/models, then ../export.
SENTE_MODEL_DIR=

# Model artifact file names inside SENTE_MODEL_DIR.
SENTE_MODEL_FILE=sente_speak_float32.tflite
SENTE_LABELS_FILE=labels.txt
SENTE_METADATA_FILE=model_metadata.json

# The shipped TFLite export has /127.5 and -1.0 fused into its graph, so the
# service supplies raw 0-255 RGB pixels. Use mobilenet_v2_preprocess only for a
# re-export whose graph does NOT contain those layers.
SENTE_INPUT_MODE=raw_0_255

# Provisional rejection policy. Tune these using the validation split.
SENTE_MIN_CONFIDENCE=0.60
SENTE_MIN_MARGIN=0.20

# Maximum accepted upload size in bytes (default 12 MB).
SENTE_MAX_UPLOAD_BYTES=12582912

# Comma-separated browser origins allowed to call the API.
SENTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
